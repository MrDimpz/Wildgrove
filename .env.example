# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Hostinger MySQL / MariaDB connection for persistent live syncing.
# Leave blank to use the built-in local JSON store (data/sanctuary-db.json).
# Tables are prefixed with wg_* so you can safely share an existing database.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_NAME=
MYSQL_SSL=false

# Admin Console (/admin) credentials.
# Set ADMIN_USERNAME and ADMIN_PASSWORD in your hosting environment / Secrets panel.
# If left blank, the /admin page offers a one-time first-run setup form that hashes
# and saves your chosen credentials securely on the server.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
